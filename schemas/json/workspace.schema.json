{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insidertrader.local/schemas/workspace.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "panels"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 100},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "panels": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "location", "visible"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "location": {"enum": ["dock", "tab", "split", "float", "window"]},
          "visible": {"type": "boolean"},
          "link_group": {"type": "string", "maxLength": 32}
        }
      }
    }
  }
}
